{
  "name": "beyond-beaches",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A comprehensive travel platform connecting travelers with local guides and agencies",
  "scripts": {
    "dev:frontend": "cd src && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd src && npm install && npm run build",
    "build:backend": "cd backend && npm install",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd src && npm start",
    "deploy:frontend": "npm run build:frontend && npm run start:frontend",
    "deploy:backend": "npm run build:backend && npm run start:backend"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "axios": "^1.13.2",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^6.8.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.0",
    "three": "^0.158.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "travel",
    "tourism",
    "guides",
    "agencies",
    "booking",
    "react",
    "three.js"
  ],
  "author": "BeyondBeaches Team",
  "license": "MIT"
}
